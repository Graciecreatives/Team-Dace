# Copy this file to .env and fill in your own values. NEVER commit .env.
# Nuxt loads .env in development. Production needs these in server secrets.
# Restart the server after changing values. See docs/SUPABASE_AUTH.md.

# --- Website and Supabase email/password authentication ---
# Use your real HTTPS domain in production. Add APP_URL/login to Supabase's
# Authentication > URL Configuration allowed redirects, and set its Site URL.
APP_URL=http://localhost:3000
FARMBUDDY_AUTH=supabase
# Project Settings > API / Connect. URL must be your project HTTPS origin.
SUPABASE_URL=
# Public/publishable project key, NOT the service-role key. Auth uses this key.
SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative to the publishable key. Fill ONE public key field only.
SUPABASE_ANON_KEY=

# --- Supabase PostgreSQL application data ---
# Provision schema and import/init explicitly BEFORE starting in Supabase mode.
# See docs/SUPABASE_DATABASE.md. Auth and database are separate integrations.
FARMBUDDY_DATABASE=supabase
# PostgreSQL connection URI from Connect, NOT the HTTPS project URL/API key.
# Keep the password URL-encoded. Use verified TLS. Never expose to the browser.
SUPABASE_DATABASE_URL=

# --- Supabase private product-photo storage ---
# Server-only privileged service-role key. NEVER use it as an Auth/public key.
# Run supabase/product-images.sql to create the private bucket first.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=farm-products
# Optional: auto Supabase in cloud database mode. Local override is refused there.
# FARMBUDDY_IMAGE_STORAGE=supabase

# --- OpenRouter AI gateway for FarmBuddyAI text and supported photo replies ---
# Calls go to https://openrouter.ai/api/v1/chat/completions from the SERVER.
# This is an OpenRouter key, not an OpenAI or Vercel AI Gateway key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# --- Optional YarnGPT spoken replies ---
YARNGPT_API_KEY=
# Leave blank for provider default, or exact case-sensitive catalogue voice name.
YARNGPT_VOICE=

# --- Optional weather and map provider settings ---
# Paid commercial Open-Meteo key. Blank selects the non-commercial endpoint.
OPEN_METEO_API_KEY=
# These tile settings are public. NEVER place secret tokens in NUXT_PUBLIC vars.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors

# --- Optional LOCAL development without Supabase ---
# Deliberately set FARMBUDDY_AUTH=local and FARMBUDDY_DATABASE=local above.
# Keep Supabase credentials blank, or set FARMBUDDY_IMAGE_STORAGE=local explicitly.
# Local credentials do not automatically become Supabase Auth accounts.
# FARMBUDDY_DATA_FILE=/absolute/persistent/path/farmbuddy.json
# FARMBUDDY_UPLOAD_DIR=/absolute/persistent/path/uploads
