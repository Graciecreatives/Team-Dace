# Copy to .env for local development. Never commit real keys.
# Set server environment variables through your production secret manager.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
YARNGPT_API_KEY=
# Optional: blank uses the provider default. Otherwise use the exact case-sensitive
# name from authenticated GET https://api.yarngpt.ai/api/v1/voices.
YARNGPT_VOICE=
# Explicit local development mode. For production change to supabase, provision
# and import your data as described in docs/SUPABASE_DATABASE.md before starting.
FARMBUDDY_DATABASE=local
SUPABASE_DATABASE_URL=
# Supabase product photos need a PRIVATE bucket and server-only service key.
# See docs/PRODUCT_PHOTOS.md. Database URL and project URL are different values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=farm-products
# Optional override: local or supabase. Local is refused for a Supabase database.
# FARMBUDDY_IMAGE_STORAGE=local
# Optional persistent paths for local development, never ephemeral production.
# FARMBUDDY_DATA_FILE=/absolute/persistent/path/farmbuddy.json
# FARMBUDDY_UPLOAD_DIR=/absolute/persistent/path/uploads
# Optional paid commercial Open-Meteo key. Blank uses non-commercial endpoint.
OPEN_METEO_API_KEY=
# Optional public HTTPS tile template and provider attribution.
# Never put secret API keys in NUXT_PUBLIC values.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors
