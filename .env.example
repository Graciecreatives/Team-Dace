# Copy to .env for local development. Never commit real keys.
# Restart Nuxt after editing. Production secrets are uploaded with npm run cf:secrets.
# Cloudflare hosting, D1 and R2 are configured in wrangler.jsonc, not API keys here.

# --- Local development ---
APP_URL=http://localhost:3000
# App-owned email/password authentication. Accounts and sessions use the selected DB.
FARMBUDDY_AUTH=local
# npm run dev / npm run host use the local JSON store and local photos.
# npm run cf:dev uses local emulated D1/R2. Deployment uses real Cloudflare bindings.
FARMBUDDY_DATABASE=local
FARMBUDDY_IMAGE_STORAGE=local
# Optional persistent local paths, never point tests at real data.
# FARMBUDDY_DATA_FILE=/absolute/persistent/path/farmbuddy.json
# FARMBUDDY_UPLOAD_DIR=/absolute/persistent/path/uploads

# --- Cloudflare Workers AI for FarmBuddyAI chat and dictation ---
# No API key needed. Wrangler supplies the private AI binding in wrangler.jsonc.
# npm run cf:dev uses real remote inference, subject to your Workers AI quota.
# Plain npm run dev / host has no AI binding and cannot run native AI chat.
# Change the production model in wrangler.jsonc, not only this local example.
FARMBUDDY_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Dictation uses the same AI binding with @cf/openai/whisper-large-v3-turbo.
# No speech API key needed. Stop recording to transcribe, then review and Send.
# Browser microphone access requires HTTPS or localhost. Audio is not saved.

# --- Specialist plant image recognition (separate from Workers AI) ---
# Get a private API key from your Pl@ntNet developer account.
# Enables plant species identification and limited disease/pest screening only.
# Provider quota/terms apply. Plant recognition does not support livestock.
PLANTNET_API_KEY=

# Optional experimental cattle photo-pattern screening, not veterinary diagnosis.
# Public research detector has limited evidence. Review docs/ANIMAL_VISION.md first.
# Roboflow inference may use paid credits. Enable only after reviewing your plan.
ROBOFLOW_API_KEY=
FARMBUDDY_EXPERIMENTAL_ANIMAL_SCAN=false

# --- YarnGPT spoken replies ---
YARNGPT_API_KEY=
# Optional exact catalogue voice name. Blank uses the provider default.
YARNGPT_VOICE=

# --- OpenWeather free five-day / three-hour forecast ---
# Server-only key. No One Call subscription is used. Blank disables live weather.
OPENWEATHER_API_KEY=

# --- Public map settings, no secret keys ---
NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NUXT_PUBLIC_MAP_ATTRIBUTION="OpenStreetMap contributors"

# --- Cloudflare ---
# Wrangler uses your existing local OAuth login. D1 and R2 use private bindings:
# FARMBUDDY_DB -> farmbuddy-db, FARMBUDDY_IMAGES -> farmbuddy-products.
# Do not add database passwords, R2 access keys or Cloudflare API tokens here.
# For CI only, set CLOUDFLARE_API_TOKEN in the CI secret store with scoped rights.
# See docs/CLOUDFLARE.md for provisioning, migration, preview and deployment.
