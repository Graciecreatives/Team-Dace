# Copy to .env for local development. Never commit real keys.
# Set these as server environment variables for production.
OPENAI_API_KEY=
FARMBUDDY_AI_MODEL=gpt-4.1-mini
YARNGPT_API_KEY=
# Optional. Discover an available voice from YarnGPT's current voice catalogue.
YARNGPT_VOICE=
# Optional paid commercial Open-Meteo key. Blank uses its non-commercial endpoint.
OPEN_METEO_API_KEY=
# Optional absolute path on persistent storage. Single Node process only.
# FARMBUDDY_DATA_FILE=/absolute/persistent/path/farmbuddy.json
# Optional public HTTPS tile template and provider attribution for production maps.
# Never put secret API keys in NUXT_PUBLIC values.
# NUXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NUXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors
